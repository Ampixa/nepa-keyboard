{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ampixa.com/schemas/nepa-keyboard-alias-row.schema.json",
  "title": "Nepa Keyboard input alias row",
  "type": "object",
  "additionalProperties": false,
  "required": ["alias", "form_id", "scheme", "source_ids", "evidence"],
  "properties": {
    "alias": { "type": "string", "minLength": 1 },
    "form_id": { "type": "string", "minLength": 1 },
    "rank_delta": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647, "default": 0 },
    "scheme": { "type": "string", "minLength": 1 },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": { "type": "string", "enum": ["attested", "induced", "generated", "mixed"] }
  }
}
