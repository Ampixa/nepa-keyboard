{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ampixa.com/schemas/hamro-parity-v1.schema.json",
  "title": "Hamro Keyboard observable parity matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version_name",
        "version_code",
        "provenance_sha256"
      ],
      "properties": {
        "package": {
          "const": "com.hamrokeyboard"
        },
        "version_name": {
          "const": "5.4.4"
        },
        "version_code": {
          "const": 114
        },
        "provenance_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "evidence_class",
        "confidence",
        "preconditions",
        "steps",
        "expected",
        "evidence",
        "implementation_owner",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
        },
        "area": {
          "enum": [
            "setup",
            "chrome",
            "geometry",
            "candidate",
            "preview",
            "popup",
            "shift",
            "layout",
            "editor",
            "emoji",
            "sticker",
            "theme",
            "settings",
            "feedback",
            "accessibility",
            "reliability"
          ]
        },
        "evidence_class": {
          "enum": [
            "observed_exact",
            "static_exact",
            "implementation_inference",
            "intentional_nepa_deviation"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "expected": {
          "type": "object",
          "minProperties": 1
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "implementation_owner": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "test_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "not_started",
            "partial",
            "matched",
            "blocked",
            "accepted_deviation"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
