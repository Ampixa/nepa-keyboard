{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ampixa.com/schemas/nepa-keyboard-form-row.schema.json",
  "title": "Nepa Keyboard canonical form row",
  "type": "object",
  "additionalProperties": false,
  "required": ["form_id", "surface", "rank_score", "source_ids", "evidence"],
  "properties": {
    "form_id": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "rank_score": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": { "type": "string", "enum": ["attested", "induced", "generated", "mixed"] }
  }
}
