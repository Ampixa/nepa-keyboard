{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ampixa.com/schemas/nepa-keyboard-validation-query.schema.json",
  "title": "Nepa Keyboard deterministic lookup validation row",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "profile_id", "pack_id", "index", "query", "review_status"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "profile_id": { "type": "string", "minLength": 1 },
    "pack_id": { "type": "string", "minLength": 1 },
    "index": { "type": "string", "enum": ["surface", "aliases"] },
    "query": { "type": "string", "minLength": 1 },
    "expected_surface": { "type": "string", "minLength": 1 },
    "max_rank": { "type": "integer", "minimum": 1, "maximum": 32 },
    "expect_empty": { "type": "boolean" },
    "review_status": { "type": "string", "enum": ["fixture", "pending_speaker_review", "speaker_reviewed"] }
  },
  "oneOf": [
    { "required": ["expected_surface", "max_rank"], "not": { "required": ["expect_empty"] } },
    { "required": ["expect_empty"], "properties": { "expect_empty": { "const": true } }, "not": { "required": ["expected_surface"] } }
  ]
}
