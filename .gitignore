# Android build outputs and remotely staged internal benchmark pack.
/android/.gradle/
/android/**/build/
/android/local.properties
/android/benchmark-app/src/main/assets/*.nkp

# Release signing material must stay outside source control.
*.jks
*.keystore
/android/keystore.properties
